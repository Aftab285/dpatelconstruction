---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title='Contact Us | D Patel Construction' description='Get in touch with D Patel Construction for your next construction project. Request a quote, ask questions, or schedule a consultation.'>
  <Header currentPath={Astro.url.pathname} />
  <main>
    <section class="page-hero">
      <div class="page-hero-content">
        <span class="eyebrow">GET IN TOUCH</span>
        <h1>Let's Build Something Great Together</h1>
      </div>
    </section>

    <section class="section">
      <div class="container contact-grid">
        <div class="contact-form-wrapper">
          <h2>Send Us a Message</h2>
          <form class="contact-form" id="contactForm" method="POST">
            <div id="formStatus" class="form-status" style="display: none;"></div>

            <div class="form-row">
              <div class="form-group">
                <label for="fullName">Full Name</label>
                <input type="text" id="fullName" name="fullName" required />
              </div>
              <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required />
              </div>
            </div>
            
            <div class="form-row">
              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" required />
              </div>
              <div class="form-group">
                <label for="projectType">Project Type</label>
                <select id="projectType" name="projectType">
                  <option value="Ground Up Development">Ground Up Development (Hotel, Multifamily, Residential)</option>
                  <option value="Tenant Improvements">Tenant Improvements (Office & Residential)</option>
                  <option value="Adaptive Reuse Conversions">Adaptive Reuse Conversions</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>
            
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="6" required></textarea>
            </div>
            
            <button type="submit" id="submitBtn" class="btn-primary">
              <span class="btn-text">Send Message</span>
              <span class="btn-spinner" style="display: none;">Sending...</span>
            </button>
          </form>
        </div>
        
        <div class="contact-info">
          <h2>Contact Information</h2>
          <p class="info-desc">Ready to start your next project? Reach out to us for a free consultation and quote.</p>
          
          <div class="info-item">
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <div>
              <div class="info-label">Phone</div>
              <div class="info-value"><a href="tel:6192933349" class="info-link">619.293.3349</a></div>
            </div>
          </div>
          
          <div class="info-item">
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <div>
              <div class="info-label">Email</div>
              <div class="info-value"><a href="mailto:info@dpatelconstruction.com" class="info-link">info@dpatelconstruction.com</a></div>
            </div>
          </div>
          
          <div class="info-item">
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <div>
              <div class="info-label">Address</div>
              <div class="info-value">4085 Pacific Highway, Suite 110<br />San Diego, CA 92110</div>
            </div>
          </div>
          
          <div class="info-item">
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div>
              <div class="info-label">Hours</div>
              <div class="info-value">Mon–Fri: 7:00 AM – 6:00 PM</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    const statusEl = document.getElementById('formStatus') as HTMLElement | null;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;

    if (form && statusEl && submitBtn) {
      const btnText = submitBtn.querySelector('.btn-text') as HTMLElement | null;
      const btnSpinner = submitBtn.querySelector('.btn-spinner') as HTMLElement | null;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        statusEl.style.display = 'none';
        statusEl.className = 'form-status';
        statusEl.innerHTML = '';

        const formData = new FormData(form);
        const payload = {
          fullName: formData.get('fullName'),
          email: formData.get('email'),
          phone: formData.get('phone'),
          projectType: formData.get('projectType'),
          message: formData.get('message'),
        };

        submitBtn.disabled = true;
        if (btnText) btnText.style.display = 'none';
        if (btnSpinner) btnSpinner.style.display = 'inline-block';

        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          const result = await response.json();

          if (response.ok && result.success) {
            form.reset();
            statusEl.className = 'form-status success';
            statusEl.innerHTML = '<strong>Inquiry Sent!</strong> Thank you, your message has been sent to info@dpatelconstruction.com. Our team will review your project details and get back to you shortly.';
            statusEl.style.display = 'block';
          } else {
            statusEl.className = 'form-status error';
            statusEl.innerHTML = '<strong>Error:</strong> ' + (result.error || 'Failed to send your message. Please try again or call us directly at 619.293.3349.');
            statusEl.style.display = 'block';
          }
        } catch (err) {
          statusEl.className = 'form-status error';
          statusEl.innerHTML = '<strong>Submission Error:</strong> Unable to reach the server. Please call us directly at <a href="tel:6192933349" style="color: inherit; font-weight: 600;">619.293.3349</a> or email <a href="mailto:info@dpatelconstruction.com" style="color: inherit; font-weight: 600;">info@dpatelconstruction.com</a>.';
          statusEl.style.display = 'block';
        } finally {
          submitBtn.disabled = false;
          if (btnText) btnText.style.display = 'inline-block';
          if (btnSpinner) btnSpinner.style.display = 'none';
        }
      });
    }
  </script>
</Layout>

<style>
  /* Page Hero */
  .page-hero {
    height: 50vh;
    min-height: 400px;
    background-image: url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1920&q=80&fit=crop');
    background-size: cover;
    background-position: center;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(15, 37, 64, 0.7);
    z-index: 1;
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 1.5rem;
  }

  .eyebrow {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }

  .page-hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-white);
    max-width: 800px;
    margin: 0 auto;
  }

  /* Contact Section */
  .contact-grid {
    display: grid;
    grid-template-columns: 60% 40%;
    gap: 4rem;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-navy-dark);
    margin-bottom: 2rem;
  }

  /* Form */
  .contact-form {
    width: 100%;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-charcoal);
    margin-bottom: 0.5rem;
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  input, select, textarea {
    width: 100%;
    padding: 1rem;
    border: 1px solid var(--color-gray-light);
    font-family: inherit;
    font-size: 1rem;
    background: var(--color-white);
    transition: border-color 0.3s ease;
    box-sizing: border-box;
  }

  input:focus, select:focus, textarea:focus {
    border-color: var(--color-gold);
    outline: none;
  }

  .btn-primary {
    display: inline-block;
    background-color: var(--color-gold);
    color: var(--color-navy-dark);
    padding: 1rem 2.25rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    margin-top: 1rem;
  }

  .btn-primary:hover {
    background-color: var(--color-gold-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }

  .btn-primary:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  /* Form Status Alert */
  .form-status {
    padding: 1.125rem 1.25rem;
    border-radius: 4px;
    margin-bottom: 2rem;
    font-size: 0.95rem;
    line-height: 1.6;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .form-status.success {
    background-color: #f0fdf4;
    border: 1px solid #86efac;
    color: #166534;
  }

  .form-status.error {
    background-color: #fef2f2;
    border: 1px solid #fca5a5;
    color: #991b1b;
  }

  /* Contact Info */
  .info-desc {
    color: var(--color-charcoal);
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .icon {
    width: 24px;
    height: 24px;
    stroke: var(--color-gold);
    flex-shrink: 0;
  }

  .info-label {
    font-weight: 600;
    color: var(--color-navy);
    font-size: 0.85rem;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .info-value {
    color: var(--color-charcoal);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .info-link {
    color: var(--color-charcoal);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .info-link:hover {
    color: var(--color-gold);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
