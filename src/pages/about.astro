---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title='About Us | D Patel Construction' description='Learn about D Patel Construction — our story, values, and commitment to quality construction and lasting client relationships.'>
  <Header currentPath={Astro.url.pathname} />
  <main>
    <section class="page-hero">
      <div class="page-hero-content">
        <span class="eyebrow">ABOUT US</span>
        <h1>Building With Integrity Since Day One</h1>
      </div>
    </section>

    <section class="section about-story">
      <div class="container story-grid">
        <div class="story-content reveal">
          <h2>Our Story</h2>
          <p>Founded on the principles of hard work and uncompromising quality, D Patel Construction has grown from a humble local contractor into one of San Diego's most trusted building partners. Our journey began with a simple belief: that every structure we build should stand as a testament to our dedication.</p>
          <p>Over the years, we have expanded our capabilities while maintaining the personalized service and attention to detail of a boutique firm. Our growth has been fueled by strong community relationships, word-of-mouth referrals, and a consistent track record of delivering complex projects on time and within budget.</p>
          <p>Today, our quality-first philosophy remains unchanged. We don't just build buildings; we build lasting relationships with our clients, partners, and the communities we serve. When you choose D Patel Construction, you're choosing a partner who is as invested in your vision as you are.</p>
        </div>
        <div class="story-image reveal">
          <img src="https://images.unsplash.com/photo-1581094794329-c8112a89af12?w=800&q=80&fit=crop" alt="D Patel Construction team working on a project" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="section values-section">
      <div class="container">
        <h2 class="text-center reveal">Our Core Values</h2>
        <div class="values-grid">
          <div class="value-card reveal">
            <h3>Integrity</h3>
            <p>We believe in honest, transparent communication and doing the right thing, even when no one is watching. Trust is the foundation of every project.</p>
          </div>
          <div class="value-card reveal">
            <h3>Excellence</h3>
            <p>We are committed to delivering the highest quality craftsmanship in every detail. Good enough is never enough; we strive for perfection.</p>
          </div>
          <div class="value-card reveal">
            <h3>Safety</h3>
            <p>The well-being of our team, partners, and clients is our top priority. We maintain rigorous safety standards on every job site without compromise.</p>
          </div>
          <div class="value-card reveal">
            <h3>Innovation</h3>
            <p>We continuously embrace new technologies, sustainable practices, and building methods to provide smarter, more efficient construction solutions.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section stats-section">
      <div class="container stats-grid">
        <div class="stat-item reveal">
          <div class="stat-number">15+</div>
          <div class="stat-label">Years Experience</div>
        </div>
        <div class="stat-item reveal">
          <div class="stat-number">250+</div>
          <div class="stat-label">Projects Completed</div>
        </div>
        <div class="stat-item reveal">
          <div class="stat-number">200+</div>
          <div class="stat-label">Happy Clients</div>
        </div>
        <div class="stat-item reveal">
          <div class="stat-number">50+</div>
          <div class="stat-label">Skilled Professionals</div>
        </div>
      </div>
    </section>

    <CTASection />
  </main>
  <Footer />
</Layout>

<style>
  /* Variables from Design System */
  :root {
    --color-navy: #1B3A5C;
    --color-navy-dark: #0F2540;
    --color-gold: #D4A017;
    --color-gold-light: #E8B84B;
    --color-gold-hover: #C4911A;
    --color-white: #FFFFFF;
    --color-off-white: #F7F5F0;
    --color-charcoal: #2C2C2C;
    --color-gray: #6B7280;
    --color-gray-light: #E5E7EB;
    --color-concrete: #EDEDED;
  }

  /* Page Hero */
  .page-hero {
    height: 50vh;
    min-height: 400px;
    background-image: url('https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=1920&q=80&fit=crop');
    background-size: cover;
    background-position: center;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(15, 37, 64, 0.7);
    z-index: 1;
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 1.5rem;
  }

  .eyebrow {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }

  .page-hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-white);
    max-width: 800px;
    margin: 0 auto;
  }

  /* Story Section */
  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .story-content h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-navy-dark);
    margin-bottom: 2rem;
  }

  .story-content p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-charcoal);
    margin-bottom: 1.5rem;
  }

  .story-image img {
    width: 100%;
    height: auto;
    border-left: 10px solid var(--color-gold);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }

  /* Values Section */
  .values-section {
    background-color: var(--color-off-white);
  }

  .text-center {
    text-align: center;
    margin-bottom: 4rem;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--color-navy-dark);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .value-card {
    background: var(--color-white);
    border-left: 4px solid var(--color-gold);
    padding: 2.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  .value-card h3 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 600;
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  .value-card p {
    color: var(--color-charcoal);
    line-height: 1.7;
  }

  /* Stats Section */
  .stats-section {
    background-color: var(--color-navy-dark);
    color: var(--color-white);
    text-align: center;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .stat-number {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: var(--color-gold);
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-white);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .story-grid {
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
    .values-grid {
      grid-template-columns: 1fr;
    }
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 2rem;
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
