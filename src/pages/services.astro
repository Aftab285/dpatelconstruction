---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    id: "ground-up",
    title: "Ground Up Development",
    subtitle: "Hotel, Multifamily, Single Family Residences",
    image: "https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=1000&q=80&fit=crop",
    desc1: "D Patel Construction specializes in turnkey, ground-up development across hospitality, high-density multifamily housing, and bespoke single-family luxury estates. From initial site excavation to final structural envelope and luxury finishes, we deliver complete end-to-end execution.",
    desc2: "Our engineering and project management teams collaborate closely with developers, architects, and municipal officials to guarantee structural integrity, code compliance, and expedited delivery without sacrificing quality.",
    bullets: ["Bespoke Single Family Estates", "Boutique & Luxury Hotels", "Multi-Family Residential Developments", "Comprehensive Site Preparation & Foundation"]
  },
  {
    id: "tenant-improvements",
    title: "Tenant Improvements",
    subtitle: "Office and Residential",
    image: "https://images.unsplash.com/photo-1497366216548-37526070297c?w=1000&q=80&fit=crop",
    desc1: "We provide tailored tenant improvement services designed to maximize interior functionality and reflect modern brand aesthetics. Whether revamping corporate office suites or elevating luxury multi-unit residential spaces, we deliver flawless craftsmanship.",
    desc2: "Our streamlined construction workflows minimize operational downtime for commercial tenants while transforming residential units into high-demand, premium living environments with custom millwork, advanced MEP systems, and modern finishes.",
    bullets: ["Corporate Office Build-Outs", "Luxury Residential Unit Upgrades", "MEP (Mechanical, Electrical, Plumbing) Overhauls", "Acoustical & Architectural Wall Systems"]
  },
  {
    id: "adaptive-reuse",
    title: "Adaptive Reuse Conversions",
    subtitle: "Historic & Structural Repurposing",
    image: "https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=1000&q=80&fit=crop",
    desc1: "Preserving historical character while integrating state-of-the-art structural performance, our adaptive reuse conversions breathe new economic life into existing commercial, industrial, and heritage structures.",
    desc2: "We excel in navigating complex zoning, structural retrofitting, seismic upgrades, and historical preservation guidelines, transforming obsolete buildings into vibrant mixed-use, residential, or creative commercial spaces.",
    bullets: ["Industrial-to-Residential Conversions", "Historic Building Modernization", "Structural Seismic Retrofitting", "Sustainable Envelope Upgrades"]
  }
];
---

<Layout title='Our Services | D Patel Construction' description='Explore D Patel Construction services — Ground Up Development (Hotel, Multifamily, Single Family Residences), Tenant Improvements (Office & Residential), and Adaptive Reuse Conversions.'>
  <Header currentPath={Astro.url.pathname} />
  <main>
    <section class="page-hero">
      <div class="page-hero-content">
        <span class="eyebrow">OUR SERVICES</span>
        <h1>Comprehensive Construction Solutions</h1>
      </div>
    </section>

    <section class="section">
      <div class="container">
        {services.map((service, index) => (
          <div class={`service-block ${index % 2 !== 0 ? 'reversed' : ''}`} id={service.id}>
            <div class="service-image reveal">
              <img src={service.image} alt={service.title} loading="lazy" />
            </div>
            <div class="service-content reveal">
              <span class="service-number">{(index + 1).toString().padStart(2, '0')}</span>
              <h2>{service.title}</h2>
              <span class="service-subhead">{service.subtitle}</span>
              <p>{service.desc1}</p>
              <p>{service.desc2}</p>
              <ul class="service-bullets">
                {service.bullets.map(bullet => (
                  <li>{bullet}</li>
                ))}
              </ul>
              <a href="/contact" class="btn-primary">Get a Quote</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <CTASection />
  </main>
  <Footer />
</Layout>

<style>
  /* Page Hero */
  .page-hero {
    height: 50vh;
    min-height: 400px;
    background-image: url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1920&q=80&fit=crop');
    background-size: cover;
    background-position: center;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(15, 37, 64, 0.7);
    z-index: 1;
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 1.5rem;
  }

  .eyebrow {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }

  .page-hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-white);
    max-width: 800px;
    margin: 0 auto;
  }

  /* Services Detail */
  .service-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    margin-bottom: 7rem;
  }

  .service-block:last-child {
    margin-bottom: 0;
  }

  .service-block.reversed .service-image {
    order: 2;
  }

  .service-block.reversed .service-content {
    order: 1;
  }

  .service-image {
    aspect-ratio: 16/10;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }

  .service-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .service-block:hover .service-image img {
    transform: scale(1.05);
  }

  .service-number {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-gold);
    display: block;
    margin-bottom: 0.5rem;
  }

  .service-content h2 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-navy-dark);
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .service-subhead {
    display: inline-block;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-gold);
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }

  .service-content p {
    color: var(--color-charcoal);
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .service-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .service-bullets li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--color-navy);
    font-weight: 500;
  }

  .service-bullets li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-gold);
    font-weight: bold;
  }

  .btn-primary {
    display: inline-block;
    background-color: var(--color-gold);
    color: var(--color-navy-dark);
    padding: 1rem 2.25rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .btn-primary:hover {
    background-color: var(--color-gold-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .service-block {
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .service-block {
      grid-template-columns: 1fr;
      margin-bottom: 5rem;
    }
    
    .service-block.reversed .service-image,
    .service-block.reversed .service-content {
      order: unset;
    }
    
    .service-bullets {
      grid-template-columns: 1fr;
    }
  }
</style>
