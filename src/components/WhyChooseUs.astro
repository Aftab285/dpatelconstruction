---
const advantages = [
  {
    number: "01",
    title: "Quality Craftsmanship",
    tag: "Artisanal Execution",
    description: "Every build utilizes rigorously vetted materials, master tradespeople, and strict structural standards to deliver enduring excellence.",
    type: "shield"
  },
  {
    number: "02",
    title: "Reliable Project Management",
    tag: "On-Time & On-Budget",
    description: "Milestone-driven scheduling, transparent real-time reporting, and proactive problem-solving keep your project seamlessly on track.",
    type: "schedule"
  },
  {
    number: "03",
    title: "Meticulous Attention to Detail",
    tag: "Zero-Compromise QA",
    description: "From foundation reinforcement to micro-level finish tolerances, we obsess over the details that define true architectural distinction.",
    type: "precision"
  },
  {
    number: "04",
    title: "Client-Centered Partnership",
    tag: "Direct Leadership",
    description: "We work directly alongside owners and architects with responsive communication, transparent costs, and a collaborative mindset.",
    type: "partnership"
  }
];

const metrics = [
  { value: "15+", label: "Years of Excellence" },
  { value: "250+", label: "Projects Completed" },
  { value: "100%", label: "Safety Compliance" },
  { value: "98%", label: "Client Satisfaction" }
];
---

<section class="why-us section">
  <div class="container">
    <!-- Header Section with Split Intro -->
    <div class="why-us-header reveal">
      <div class="header-left">
        <span class="section-label">WHY D PATEL CONSTRUCTION</span>
        <h2 class="section-title">Built on Quality.<br />Driven by Trust.</h2>
      </div>
      <div class="header-right">
        <p class="header-narrative">
          We bring engineering rigor, complete cost transparency, and master-level building practices to every residential and commercial project, ensuring results that exceed expectations.
        </p>
      </div>
    </div>

    <!-- 4 Architectural Advantage Cards -->
    <div class="why-us-grid reveal">
      {advantages.map((item) => (
        <div class="advantage-card">
          <div class="card-accent-line"></div>
          
          <div class="card-top">
            <div class="icon-box">
              {item.type === 'shield' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#D4A017" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              )}
              {item.type === 'schedule' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#D4A017" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              )}
              {item.type === 'precision' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#D4A017" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="22" y1="12" x2="18" y2="12"></line>
                  <line x1="6" y1="12" x2="2" y2="12"></line>
                  <line x1="12" y1="6" x2="12" y2="2"></line>
                  <line x1="12" y1="22" x2="12" y2="18"></line>
                </svg>
              )}
              {item.type === 'partnership' && (
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#D4A017" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              )}
            </div>
            <span class="card-number">{item.number}</span>
          </div>

          <div class="card-body">
            <span class="card-tag">{item.tag}</span>
            <h3 class="card-title">{item.title}</h3>
            <p class="card-desc">{item.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Proven Performance Metrics Bar -->
    <div class="metrics-bar reveal">
      {metrics.map((metric, index) => (
        <div class="metric-item">
          <span class="metric-value">{metric.value}</span>
          <span class="metric-label">{metric.label}</span>
          {index < metrics.length - 1 && <div class="metric-divider" />}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-us {
    background-color: var(--color-navy-dark);
    color: var(--color-white);
    padding: 7rem 0;
    position: relative;
    overflow: hidden;
  }

  /* Subtle ambient lighting effect */
  .why-us::before {
    content: '';
    position: absolute;
    top: -150px;
    right: -150px;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 160, 23, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
    z-index: 2;
  }

  /* Split Header */
  .why-us-header {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: flex-end;
    margin-bottom: 3.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .section-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
    display: block;
    margin-bottom: 1rem;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .section-title {
    font-family: 'Inter', system-ui, sans-serif;
    color: var(--color-white);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .header-narrative {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
  }

  /* Advantage Cards Grid */
  .why-us-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
    margin-bottom: 4.5rem;
  }

  .advantage-card {
    position: relative;
    background: linear-gradient(155deg, rgba(27, 58, 92, 0.5) 0%, rgba(15, 37, 64, 0.8) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 0.4s ease;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .advantage-card:hover {
    background: linear-gradient(155deg, rgba(27, 58, 92, 0.7) 0%, rgba(15, 37, 64, 0.95) 100%);
    border-color: var(--color-gold);
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4), 0 0 20px rgba(212, 160, 23, 0.15);
  }

  /* Top Gold Line on Hover */
  .card-accent-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.2, 0, 0.2, 1);
  }

  .advantage-card:hover .card-accent-line {
    transform: scaleX(1);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .icon-box {
    width: 52px;
    height: 52px;
    border-radius: 6px;
    background: rgba(212, 160, 23, 0.12);
    border: 1px solid rgba(212, 160, 23, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .advantage-card:hover .icon-box {
    background: rgba(212, 160, 23, 0.25);
    border-color: var(--color-gold);
    transform: scale(1.05);
  }

  .card-number {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-gold);
    letter-spacing: 0.05em;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .advantage-card:hover .card-number {
    opacity: 1;
  }

  .card-tag {
    display: inline-block;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.725rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gold);
    margin-bottom: 0.5rem;
  }

  .card-title {
    font-family: 'Inter', system-ui, sans-serif;
    color: var(--color-white);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.875rem 0;
  }

  .card-desc {
    font-family: 'Inter', system-ui, sans-serif;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
  }

  /* Metrics Bar */
  .metrics-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 2.5rem 1.5rem;
  }

  .metric-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 1rem;
  }

  .metric-value {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(2.25rem, 3.5vw, 3rem);
    font-weight: 800;
    color: var(--color-gold);
    line-height: 1;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .metric-label {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  .metric-divider {
    position: absolute;
    right: 0;
    top: 15%;
    height: 70%;
    width: 1px;
    background-color: rgba(255, 255, 255, 0.12);
  }

  /* Responsive Rules */
  @media (max-width: 1024px) {
    .why-us-header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .why-us-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .metrics-bar {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }

    .metric-divider {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .why-us {
      padding: 5rem 0;
    }

    .why-us-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .metrics-bar {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2rem 1.5rem;
    }
  }
</style>
