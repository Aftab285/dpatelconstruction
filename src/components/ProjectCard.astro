---
interface Props {
  image: string;
  title: string;
  category: string;
  location: string;
}

const { image, title, category, location } = Astro.props;
---

<article class="project-card">
  <div class="project-image">
    <img src={image} alt={`${title} - ${category}`} loading="lazy" />
    <div class="project-overlay">
      <div class="project-info">
        <span class="project-category">{category}</span>
        <h3>{title}</h3>
        <span class="project-location">{location}</span>
      </div>
      <span class="project-arrow">&nearr;</span>
    </div>
  </div>
</article>

<style>
  .project-card {
    display: block;
    width: 100%;
    cursor: pointer;
  }

  .project-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 4px;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 37, 64, 0.85) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.4s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .project-info {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    right: 1.5rem;
  }

  .project-category {
    color: var(--color-gold);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    display: block;
  }

  .project-info h3 {
    color: var(--color-white);
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 0.25rem;
    margin-bottom: 0;
  }

  .project-location {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85rem;
    margin-top: 0.25rem;
    display: block;
  }

  .project-arrow {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    color: var(--color-white);
    font-size: 1.5rem;
    transition: transform 0.3s ease;
    line-height: 1;
  }

  .project-card:hover .project-image img {
    transform: scale(1.05);
  }

  .project-card:hover .project-overlay {
    opacity: 1;
  }

  .project-card:hover .project-arrow {
    transform: translate(4px, -4px);
  }
</style>
