---
import ServiceCard from './ServiceCard.astro';

const services = [
  {
    number: "01",
    title: "Ground Up Development",
    subtitle: "(Hotel, Multifamily, Single Family Residences)",
    image: "https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=900&q=80&fit=crop",
    description: "Full-scale new construction for luxury hotels, high-density multifamily complexes, and bespoke custom single-family estates.",
    href: "/services#ground-up"
  },
  {
    number: "02",
    title: "Tenant Improvements",
    subtitle: "(Office and Residential)",
    image: "https://images.unsplash.com/photo-1497366216548-37526070297c?w=900&q=80&fit=crop",
    description: "High-end interior build-outs, corporate office upgrades, and bespoke residential unit enhancements executed with precision.",
    href: "/services#tenant-improvements"
  },
  {
    number: "03",
    title: "Adaptive Reuse Conversions",
    subtitle: "(Historic & Structural Repurposing)",
    image: "https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=900&q=80&fit=crop",
    description: "Transforming existing architectural and industrial properties into modern commercial hubs and high-value living spaces.",
    href: "/services#adaptive-reuse"
  }
];
---

<section class="section services-section" id="services">
  <div class="container">
    <div class="services-header">
      <span class="section-label">WHAT WE DO</span>
      <h2 class="section-title">Comprehensive Construction Solutions</h2>
      <p class="section-subtitle">Explore our three core pillars of building excellence.</p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <ServiceCard
          number={service.number}
          title={service.title}
          subtitle={service.subtitle}
          image={service.image}
          description={service.description}
          href={service.href}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: 7rem 0;
    background-color: var(--color-off-white);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .services-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-label {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-navy-dark);
    margin-bottom: 1rem;
  }

  .section-subtitle {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1.125rem;
    color: var(--color-gray);
    max-width: 600px;
    margin: 0 auto;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .services-section {
      padding: 5rem 0;
    }
    
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
